{
  "name": "dsh-sleep-skills",
  "version": "0.1.0-alpha.4",
  "description": "Evidence-linked persistent memory and sleep consolidation for DSH agents. Research preview; no native context-window expansion.",
  "type": "module",
  "main": "src/dsh-plugin.mjs",
  "exports": {
    ".": "./src/dsh-plugin.mjs",
    "./memory": "./src/memory.mjs"
  },
  "bin": {
    "dsh-sleep": "bin/sleep.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "benchmark": "node scripts/benchmark.mjs",
    "bundle": "python3 scripts/bundle.py",
    "test:dsh": "node scripts/dsh-smoke.mjs",
    "benchmark:window": "node scripts/window-recall.mjs",
    "test:compaction": "node scripts/compaction-recall.mjs"
  },
  "files": [
    "src",
    "bin",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "memory",
    "skills",
    "continual-learning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Axiang1211/DSH_Sleep_skills.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "js-tiktoken": "1.0.21"
  }
}
